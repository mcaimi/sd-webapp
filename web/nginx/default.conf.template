# Rendered at container start by the nginx image's envsubst step:
# ${SD_API_URL} becomes the backend base URL (scheme://host:port, no path).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Inpainting posts the image and mask as base64 JSON; nginx's 1 MB default would 413.
    client_max_body_size 64m;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_pass ${SD_API_URL};
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        # Stream large model downloads instead of buffering multi-GB files to disk.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Vite emits content-hashed file names here, so they can be cached forever.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Everything else is the SPA: unknown paths get index.html for client-side routing.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
    }
}
