# Rendered at container start by the nginx image's envsubst step:
# ${SD_API_URL} becomes the backend base URL (scheme://host:port, no path) and
# SD_WEB_TOKEN, in the same syntax, the access token (set or generated by 15-auth-token.envsh).

# A request is authorized by the session cookie or by an `Authorization: Bearer`
# header. Regex matches are case-sensitive, unlike plain map strings.
map $cookie_sd_webapp_token $sd_cookie_auth {
    "~^${SD_WEB_TOKEN}$" 1;
    default 0;
}
map $http_authorization $sd_header_auth {
    "~^Bearer ${SD_WEB_TOKEN}$" 1;
    default 0;
}
map $sd_cookie_auth$sd_header_auth $sd_authorized {
    00 0;
    default 1;
}

# /auth/session: GET reports whether the request is authorized, POST with the
# bearer header signs in (sets the cookie), DELETE signs out (clears it).
map $request_method:$sd_header_auth $sd_session {
    "~^GET:" check;
    "~^POST:1$" sign-in;
    "~^POST:" denied;
    "~^DELETE:" sign-out;
    default not-allowed;
}
map $sd_authorized $sd_session_status {
    1 '{"authenticated":true}';
    default '{"authenticated":false}';
}
# Behind a TLS-terminating proxy (e.g. an OpenShift edge route), keep the cookie off plain HTTP.
map $http_x_forwarded_proto $sd_cookie_secure {
    https "; Secure";
    default "";
}
map $sd_session $sd_session_cookie {
    sign-in "sd_webapp_token=${SD_WEB_TOKEN}; Path=/; Max-Age=2592000; HttpOnly; SameSite=Strict$sd_cookie_secure";
    sign-out "sd_webapp_token=; Path=/; Max-Age=0; HttpOnly; SameSite=Strict$sd_cookie_secure";
    default "";
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Inpainting posts the image and mask as base64 JSON; nginx's 1 MB default would 413.
    client_max_body_size 64m;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /auth/session {
        add_header Set-Cookie $sd_session_cookie always;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/security-headers.conf;
        default_type application/json;
        if ($sd_session = check) {
            return 200 $sd_session_status;
        }
        if ($sd_session = denied) {
            return 401;
        }
        if ($sd_session = not-allowed) {
            return 405;
        }
        return 204;
    }

    location /api/ {
        if ($sd_authorized = 0) {
            return 401;
        }
        proxy_pass ${SD_API_URL};
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        # Stream large model downloads instead of buffering multi-GB files to disk.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Vite emits content-hashed file names here, so they can be cached forever.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Everything else is the SPA: unknown paths get index.html for client-side routing.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
    }
}
